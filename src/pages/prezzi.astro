---
import Layout from '../layouts/Layout.astro';
import PriceTable from '../components/PriceTable.astro';
import ContactForm from '../components/ContactForm.astro';
import WaveDivider from '../components/WaveDivider.astro';
import siteConfig from '../data/siteConfig.json';
import prezziData from '../data/prezzi.json';

const whatsappUrl = `https://wa.me/${siteConfig.whatsapp.replace(/\s/g, '').replace('+', '')}?text=${encodeURIComponent('Ciao! Vorrei informazioni sui prezzi di Bagni Sole Mare.')}`;
---

<Layout
  title={`Prezzi & Contatti - ${siteConfig.nome}`}
  description={`Listino prezzi spiaggia e contatti di ${siteConfig.nome} a Loano. Ombrelloni, lettini, abbonamenti stagionali. Contattaci per prenotare.`}
>
  <!-- Page header -->
  <section class="relative bg-gradient-to-br from-mare-700 to-mare-800 text-white py-12 md:py-16 overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
      <h1 class="font-display text-3xl md:text-4xl font-bold mb-2">Prezzi & Contatti</h1>
      <p class="text-mare-200">Listino spiaggia e informazioni per prenotare</p>
    </div>
    <!-- Wave separator -->
    <div class="absolute -bottom-px left-0 right-0">
      <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto block">
        <path d="M0 60V30C240 0 480 0 720 30C960 60 1200 60 1440 30V60H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Prezzi Spiaggia -->
  <section class="py-12 md:py-20">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-10 blur-in">
        <span class="text-sm font-semibold uppercase tracking-wider text-mare-500 mb-2 block">Listino</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-mare-900">Prezzi Spiaggia</h2>
      </div>

      <div class="space-y-8 stagger-children">
        {prezziData.periodi.map((periodo, i) => (
          <div class="scale-in" style={`--stagger-index: ${i}`}>
            <PriceTable
              nome={periodo.nome}
              date={periodo.date}
              file={periodo.file}
            />
          </div>
        ))}
      </div>

      <p class="text-center text-sm text-gray-500 mt-6 fade-in">{prezziData.note}</p>
    </div>
  </section>
  <WaveDivider fill="var(--color-sabbia-50)" variant="a" />

  <!-- Abbonamenti -->
  <section class="py-12 md:py-20 bg-sabbia-50">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-10 blur-in">
        <span class="text-sm font-semibold uppercase tracking-wider text-sabbia-600 mb-2 block">Risparmia</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-mare-900">Abbonamenti</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 stagger-children">
        {prezziData.abbonamenti.map((abb, i) => {
          const isHighlighted = abb.nome === 'Stagionale Standard';
          return (
            <div class:list={[
              'relative rounded-2xl p-6 hover:shadow-md transition-shadow scale-in',
              isHighlighted
                ? 'bg-mare-50 border-2 border-mare-500 shadow-md'
                : 'bg-white border border-gray-100 shadow-sm',
            ]} style={`--stagger-index: ${i}`}>
              {isHighlighted && (
                <span class="absolute -top-3 right-4 bg-mare-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                  Più scelto
                </span>
              )}
              <h3 class="font-display text-lg font-bold text-mare-900 mb-1">{abb.nome}</h3>
              <p class="text-gray-600 text-sm mb-4">{abb.descrizione}</p>
              <p class="text-2xl font-bold text-mare-600">&euro; {abb.prezzo}</p>
            </div>
          );
        })}
      </div>
    </div>
  </section>
  <WaveDivider fill="var(--color-sabbia-50)" variant="b" flip />

  <!-- Contatti -->
  <section id="contatti" class="py-12 md:py-20 scroll-mt-16">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-10 blur-in">
        <span class="text-sm font-semibold uppercase tracking-wider text-mare-500 mb-2 block">Scrivici</span>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-mare-900">Contattaci</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Form -->
        <div class="slide-in-left">
          <ContactForm />
        </div>

        <!-- Info di contatto -->
        <div class="slide-in-right space-y-6">
          <!-- Canali diretti -->
          <div class="space-y-3">
            <a
              href={`tel:${siteConfig.telefono}`}
              class="flex items-center gap-3 p-4 bg-mare-50 rounded-xl hover:bg-mare-100 transition-colors"
            >
              <div class="w-10 h-10 bg-mare-600 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500">Telefono</p>
                <p class="font-semibold text-mare-800">{siteConfig.telefonoDisplay}</p>
              </div>
            </a>

            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 p-4 bg-green-50 rounded-xl hover:bg-green-100 transition-colors"
            >
              <div class="w-10 h-10 bg-green-500 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500">WhatsApp</p>
                <p class="font-semibold text-green-700">{siteConfig.whatsappDisplay}</p>
              </div>
            </a>

            <a
              href={`mailto:${siteConfig.email}`}
              class="flex items-center gap-3 p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition-colors"
            >
              <div class="w-10 h-10 bg-mare-600 rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500">Email</p>
                <p class="font-semibold text-mare-800">{siteConfig.email}</p>
              </div>
            </a>
          </div>

          <!-- Orari e indirizzo -->
          <div class="bg-mare-50 rounded-2xl p-6 space-y-4">
            <div>
              <h3 class="font-semibold text-mare-800 mb-1">Indirizzo</h3>
              <p class="text-gray-600 text-sm">{siteConfig.indirizzo}</p>
            </div>
            <div>
              <h3 class="font-semibold text-mare-800 mb-1">Orari</h3>
              <p class="text-gray-600 text-sm">Spiaggia: {siteConfig.orari.spiaggia}</p>
              <p class="text-gray-600 text-sm">Bar: {siteConfig.orari.bar}</p>
            </div>
            <div>
              <h3 class="font-semibold text-mare-800 mb-1">Stagione</h3>
              <p class="text-gray-600 text-sm">{siteConfig.stagione}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Google Maps -->
  <section class="pb-12 md:pb-20">
    <div class="max-w-4xl mx-auto px-4 scale-in">
      <div class="rounded-2xl overflow-hidden shadow-sm border border-gray-100 h-[300px] md:h-[400px]">
        <iframe
          src={siteConfig.mapsUrl}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Posizione Bagni Sole Mare - Loano"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
