---
import siteConfig from '../data/siteConfig.json';
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="space-y-5"
  id="contact-form"
>
  <input type="hidden" name="access_key" value={siteConfig.web3formsKey} />
  <input type="hidden" name="subject" value={`Nuovo messaggio da ${siteConfig.nome}`} />
  <input type="hidden" name="from_name" value={siteConfig.nome} />
  <!-- Honeypot -->
  <input type="checkbox" name="botcheck" class="hidden" />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <label for="nome" class="block text-sm font-medium text-mare-800 mb-1.5">Nome *</label>
      <input
        type="text"
        id="nome"
        name="nome"
        required
        class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-mare-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-mare-500 focus:border-transparent transition"
        placeholder="Il tuo nome"
      />
    </div>
    <div>
      <label for="telefono" class="block text-sm font-medium text-mare-800 mb-1.5">Telefono</label>
      <input
        type="tel"
        id="telefono"
        name="telefono"
        class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-mare-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-mare-500 focus:border-transparent transition"
        placeholder="Il tuo numero"
      />
    </div>
  </div>

  <div>
    <label for="email" class="block text-sm font-medium text-mare-800 mb-1.5">Email *</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-mare-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-mare-500 focus:border-transparent transition"
      placeholder="La tua email"
    />
  </div>

  <div>
    <label for="messaggio" class="block text-sm font-medium text-mare-800 mb-1.5">Messaggio *</label>
    <textarea
      id="messaggio"
      name="messaggio"
      required
      rows="4"
      class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-mare-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-mare-500 focus:border-transparent transition resize-y"
      placeholder="Come possiamo aiutarti?"
    ></textarea>
  </div>

  <button
    type="submit"
    class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-mare-600 text-white px-8 py-3.5 rounded-xl font-semibold hover:bg-mare-700 transition-colors"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/>
    </svg>
    Invia messaggio
  </button>

  <div id="form-result" class="hidden rounded-xl px-4 py-3 text-sm font-medium"></div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const result = document.getElementById('form-result')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Invio in corso...';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
      });
      const data = await response.json();

      if (data.success) {
        result.className = 'rounded-xl px-4 py-3 text-sm font-medium bg-green-50 text-green-700 border border-green-200';
        result.textContent = 'Messaggio inviato con successo! Ti risponderemo al pi\u00F9 presto.';
        form.reset();
      } else {
        throw new Error(data.message || 'Errore');
      }
    } catch {
      result.className = 'rounded-xl px-4 py-3 text-sm font-medium bg-red-50 text-red-700 border border-red-200';
      result.textContent = 'Si \u00E8 verificato un errore. Riprova o contattaci telefonicamente.';
    }

    btn.disabled = false;
    btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/></svg>Invia messaggio';
  });
</script>
