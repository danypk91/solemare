---
interface Fila {
  tipo: string;
  giornaliero: string;
  settimanale: string;
  mensile: string;
}

interface Props {
  nome: string;
  date: string;
  file: Fila[];
}

const { nome, date, file } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
  <div class="bg-mare-700 text-white px-6 py-4">
    <h3 class="font-display text-xl font-bold">{nome}</h3>
    <p class="text-mare-200 text-sm">{date}</p>
  </div>

  <!-- Mobile: card layout -->
  <div class="md:hidden divide-y divide-gray-100">
    {file.map((f) => (
      <div class="p-4">
        <p class="font-semibold text-mare-900 mb-2">{f.tipo}</p>
        <div class="grid grid-cols-3 gap-2 text-center">
          <div>
            <p class="text-xs text-gray-500 mb-1">Giorno</p>
            <p class="font-semibold text-mare-700">&euro; {f.giornaliero}</p>
          </div>
          <div>
            <p class="text-xs text-gray-500 mb-1">Settimana</p>
            <p class="font-semibold text-mare-700">&euro; {f.settimanale}</p>
          </div>
          <div>
            <p class="text-xs text-gray-500 mb-1">Mese</p>
            <p class="font-semibold text-mare-700">&euro; {f.mensile}</p>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Desktop: table layout -->
  <div class="hidden md:block">
    <table class="w-full">
      <thead>
        <tr class="border-b border-gray-100 text-sm text-gray-500">
          <th class="text-left px-6 py-3 font-medium">Servizio</th>
          <th class="text-center px-4 py-3 font-medium">Giornaliero</th>
          <th class="text-center px-4 py-3 font-medium">Settimanale</th>
          <th class="text-center px-4 py-3 font-medium">Mensile</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        {file.map((f) => (
          <tr class="hover:bg-mare-50/50 transition-colors">
            <td class="px-6 py-3.5 text-mare-900 font-medium">{f.tipo}</td>
            <td class="px-4 py-3.5 text-center text-mare-700 font-semibold">&euro; {f.giornaliero}</td>
            <td class="px-4 py-3.5 text-center text-mare-700 font-semibold">&euro; {f.settimanale}</td>
            <td class="px-4 py-3.5 text-center text-mare-700 font-semibold">&euro; {f.mensile}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
